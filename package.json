{
  "name": "serenematt.com",
  "private": true,
  "scripts": {
    "https:setup": "portless proxy start --port 443",
    "harness": "portless harness.dotcom node tools/ui-harness/bin/ui-harness.js",
    "harness:http": "node tools/ui-harness/bin/ui-harness.js http://127.0.0.1:4173",
    "test:harness": "node --test tools/ui-harness/test/*.test.js",
    "test:https": "node tools/ui-harness/scripts/verify-https.js",
    "build": "astro build",
    "preview": "astro build && portless dotcom sh -c 'exec python3 -m http.server \"$PORT\" --bind 127.0.0.1 --directory dist'",
    "preview:http": "astro build && python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "test": "astro build && node --test tests/*.test.cjs",
    "test:browser": "astro build && node --test tests/homepage.test.cjs",
    "performance": "node scripts/measure.mjs",
    "deploy": "astro build && cf deploy"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.6",
    "@types/node": "26.6.4",
    "astro": "^7.4.2",
    "cf": "1.0.0-beta.13",
    "lighthouse": "13.5.0",
    "portless": "0.15.7",
    "typescript": "7.0.2",
    "wrangler": "^4.148.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.3",
      "onFail": "ignore"
    }
  }
}
