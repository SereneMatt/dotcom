---
const { title, description } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const pages = import.meta.glob("../pages/**/*.astro");
const routeExists = (href) => {
  const name = href === "/" ? "index" : href.replace(/^\//, "");
  return `../pages/${name}.astro` in pages || `../pages/${name}/index.astro` in pages;
};
const nav = [
  { href: "/", label: "Home" },
  { href: "/me", label: "Resume" },
  { href: "/learnings", label: "Learnings" },
].filter((item) => routeExists(item.href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <meta name="theme-color" content="#000000">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>{title}</title>
    <slot name="head" />
    <style is:inline>
      :root { color-scheme: dark; font-family: system-ui, sans-serif; color: #ffffff; background: #000000; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; }
      main { display: grid; place-content: center; padding: 3rem 1.5rem; }
      h1 { margin: 0 0 1rem; font-size: clamp(2rem, 7vw, 4rem); font-weight: 450; letter-spacing: -.065em; line-height: 1.1; }
      .pronunciation { display: flex; align-items: center; justify-content: center; gap: .75rem; }
      .phonetic { font-size: 1.25rem; color: #596052; }
      button { display: inline-grid; place-items: center; width: 2rem; height: 2rem; padding: .45rem; border: 1px solid #c3c8b9; border-radius: 50%; color: #394b32; background: transparent; cursor: pointer; }
      button:hover { background: #e7eadf; }
      button:disabled { cursor: wait; }
      button[hidden] { display: none; }
      button svg { width: .9rem; height: .9rem; }
      :focus-visible { outline: 2px solid #394b32; outline-offset: 5px; }
      .status { min-height: 1.5em; max-width: 25rem; margin: .75rem 0 0; text-align: center; font-size: .875rem; color: #596052; }
      @media (max-width: 30rem) { .status { min-height: 3em; } }
      footer { padding: 2rem 1.5rem; }
      nav { display: flex; justify-content: center; gap: 2rem; }
      body > nav { padding: .75rem 1.5rem 0; }
      a { color: inherit; text-underline-offset: .3em; text-decoration-thickness: 1px; }
      nav a { padding: .75rem .25rem; font-size: .875rem; }
    </style>
  </head>
  <body>
    <nav aria-label="Site">
      {nav.map((item) => (
        <a href={item.href} aria-current={pathname === item.href ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <slot />
  </body>
</html>
